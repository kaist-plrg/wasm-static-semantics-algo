;;
;; Syntax of Modules
;;

syntax type = rectype

syntax global = {
  GTYPE globaltype,
  GINIT const
}

syntax local = {
  LTYPE valtype
}

syntax table = {
  TTYPE tabletype,
  TINIT const
}

syntax memory = {
  MTYPE memtype
}

syntax tag = {
  TGTYPE idx
}

syntax func = {
  FTYPE idx,
  LOCALS local*,
  BODY const
}

syntax start = {
  SFUNC idx
}

syntax active = {
  INDEX idx,
  OFFSET const
}

syntax segmentmode =
  | Passive
  | Active active
  | Declarative

syntax elem = {
  ETYPE reftype,
  EINIT const*,
  EMODE segmentmode
}

syntax data = {
  DINIT text,
  DMODE segmentmode
}

syntax importdesc =
  | FuncImport idx
  | TableImport tabletype
  | MemImport memtype
  | GlobalImport globaltype
  | TagImport idx

syntax exportdesc =
  | FuncExport idx
  | TableExport idx
  | MemExport idx
  | GlobalExport idx
  | TagExport idx

syntax import = {
  MODULENAME name,
  ITEMNAME name,
  IDESC importdesc
}

syntax export = {
  NAME name,
  EDESC exportdesc
}

syntax module = {
  TYPES type*,
  GLOBALS global*,
  TABLES table*,
  MEMS memory*,
  TAGS tag*,
  FUNCS func*,
  START start?,
  ELEMS elem*,
  DATAS data*,
  IMPORTS import*,
  EXPORTS export*
}
;; Meta variables

var ty : type
var loc : local
var glob : global
var tab : table
var im : import
var ex : export
