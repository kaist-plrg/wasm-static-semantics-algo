;;
;; Syntax of Values
;;

syntax u32 = nat
syntax u64 = nat
syntax i32 = nat
syntax i64 = int
syntax exp = int
syntax byte = nat
syntax char = nat
syntax name = char*
syntax void

;; Floating-point

syntax fmag =
  | NORM m exp
  | SUBNORM m
  | INF
  | NAN (m)

syntax f32mag = fmag
syntax f64mag = fmag

syntax f32 =
  | POS f32mag
  | NEG f32mag

syntax f64 =
  | POS f64mag
  | NEG f64mag

;; Vectors
syntax vecop<A> =
  | V128 A

syntax laneop<A,B,C,D,E,F> =
  | I8x16 A | I16x8 B | I32x4 C | I64x2 D
  | F32x4 E | F64x2 F

syntax v128 = nat
syntax vec_ = vecop<v128>
var vec : vec_

dec $min_i64 : i64
def $min_i64 = $(-9223372036854775808)

dec $le_u(i64, i64) : bool
def $le_u(i64_1, i64_2) = true
  -- if i64_1' = $(i64_1 + $min_i64)
  -- if i64_2' = $(i64_2 + $min_i64)
  -- if $(i64_1' <= i64_2')
def $le_u(i64_1, i64_2) = false
  -- otherwise

dec $lt_u(i64, i64) : bool
def $lt_u(i64_1, i64_2) = true
  -- if i64_1' = $(i64_1 + $min_i64)
  -- if i64_2' = $(i64_2 + $min_i64)
  -- if $(i64_1' < i64_2')
def $lt_u(i64_1, i64_2) = false
  -- otherwise

dec $range(nat) : nat*
def $range(0) = eps
def $range(n) = $range($(n-1)) ++ [$(n-1)]
  -- if $(n > 0)

;; Indices

syntax idx = nat
;; syntax laneidx hint(desc "lane index") = u8

syntax typeidx = idx
syntax funcidx = idx
syntax globalidx = idx
syntax tableidx = idx
syntax memidx = idx
syntax tagidx = idx
syntax elemidx = idx
syntax dataidx = idx
syntax labelidx = idx
syntax localidx = idx
syntax fieldidx = idx

syntax externidx =
  | FUNC funcidx | GLOBAL globalidx | TABLE tableidx | MEM memidx | TAG tagidx

var x : idx
var y : idx
var ti : typeidx
var l : labelidx
var xx : externidx

;; list functions
dec $rev_<X>(X*) : X*
def $rev_<X>(eps) = eps
def $rev_<X>(X_h :: X_t*) = $rev_<X>(X_t*) ++ [X_h]

;; set functions

;; Free

syntax set<K> = `{ K* }

dec $empty_set<K> : set<K>
def $empty_set<K> = `{ eps }

dec $in_set<K>(K, set<K>) : bool
def $in_set<K>(K, `{ K'* }) = K <- K'*

dec $intersect_set<K>(set<K>, set<K>) : set<K>

dec $union_set<K>(set<K>, set<K>) : set<K>

dec $unions_set<K>(set<K>*) : set<K>

dec $diff_set<K>(set<K>, set<K>) : set<K>

dec $sub_set<K>(set<K>, set<K>) : bool

dec $eq_set<K>(set<K>, set<K>) : bool

dec $remove_set<K>(K, set<K>) : set<K>

dec $map_set<X, Y>(def $f(X) : Y, set<X>) : set<Y>
def $map_set<X, Y>(def $f, `{ eps }) = `{ eps }
def $map_set<X, Y>(def $f, `{ X_h :: X_t* }) = $union_set<Y>(`{[$f(X_h)]}, $map_set<X, Y>(def $f, `{ X_t* }))

syntax nameset = set<name>
