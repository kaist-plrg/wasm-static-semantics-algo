;;
;; Syntax of Values
;;

syntax u32 = nat
syntax u64 = nat
syntax i32 = int
syntax i64 = int
syntax byte = nat
syntax char = nat
syntax name = char*

dec $min_i64 : i64
def $min_i64 = $(-9223372036854775808)

dec $le_u(i64, i64) : bool
def $le_u(i64_1, i64_2) = true
  -- if i64_1' = $(i64_1 + $min_i64)
  -- if i64_2' = $(i64_2 + $min_i64)
  -- if $(i64_1' <= i64_2')
def $le_u(i64_1, i64_2) = false
  -- otherwise

dec $range(nat) : nat*
def $range(0) = eps
def $range(n) = $range($(n-1)) ++ [$(n-1)]
  -- if $(n > 0)

;; Indices

syntax idx = nat
;; syntax laneidx hint(desc "lane index") = u8

syntax typeidx = idx
syntax funcidx = idx
syntax globalidx = idx
syntax tableidx = idx
syntax memidx = idx
syntax tagidx = idx
syntax elemidx = idx
syntax dataidx = idx
syntax labelidx = idx
syntax localidx = idx
syntax fieldidx = idx

syntax externidx =
  | FUNC funcidx | GLOBAL globalidx | TABLE tableidx | MEM memidx | TAG tagidx

var x : idx
var y : idx
var ti : typeidx
var l : labelidx
var xx : externidx

;; Operators
syntax op<A, B, C, D> =
  | I32 A | I64 B | F32 C | F64 D

syntax ibinop =
  | IAdd | ISub | IMul | IDivS | IDivU | IRemS | IRemU
  | IAnd | IOr | IXor | IShl | IShrS | IShrU | IRotl | IRotr
syntax fbinop =
  | FAdd | FSub | FMul | FDiv | FMin | FMax | FCopysign

syntax binop_ = op<ibinop, ibinop, fbinop, fbinop>

var bop : binop_

;; set functions

;; Free

syntax set<K> = `{ K* }

dec $empty_set<K> : set<K>
def $empty_set<K> = `{ eps }

dec $in_set<K>(K, set<K>) : bool
def $in_set<K>(K, `{ K'* }) = K <- K'*

dec $intersect_set<K>(set<K>, set<K>) : set<K>

dec $union_set<K>(set<K>, set<K>) : set<K>

dec $unions_set<K>(set<K>*) : set<K>

dec $diff_set<K>(set<K>, set<K>) : set<K>

dec $sub_set<K>(set<K>, set<K>) : bool

dec $eq_set<K>(set<K>, set<K>) : bool

dec $remove_set<K>(K, set<K>) : set<K>

dec $map_set<X, Y>(def $f(X) : Y, set<X>) : set<Y>
def $map_set<X, Y>(def $f, `{ eps }) = `{ eps }
def $map_set<X, Y>(def $f, `{ X_h :: X_t* }) = $union_set<Y>(`{[$f(X_h)]}, $map_set<X, Y>(def $f, `{ X_t* }))

syntax nameset = set<name>
