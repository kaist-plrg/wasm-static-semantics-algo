relation Instrs_ok:
  context inferresulttype |- instr* : (inferresulttype, idx*)
  hint(input %0 %1 %2)

relation Instr_ok:
  context inferresulttype |- instr : inferinstrtype
  hint(input %0 %1 %2)

dec $local(context, typeidx) : localtype
def $local(C, x) = C.LOCALS[x]
dec $init_local(context, typeidx) : context
def $init_local(C, x) = C[ .LOCALS[x] = (LocalT Set t)]
  -- if LocalT init t = $local(C, x)

dec $init_locals(context, typeidx*) : context
def $init_locals(C, eps) = C
def $init_locals(C, x_1 :: x*) = $init_locals($init_local(C, x_1), x*)

rule Instr_ok/unop:
  C_0 irt |- UNARY uop : ({INS (NoEllipses, [t]), OUTS (NoEllipses, [t])}, eps)
  -- Unop_ok: |- uop : OK
  -- if t = NumT $type_num<iunop,iunop,funop,funop>(uop)

rule Instr_ok/testop:
  C_0 irt |- TEST top : ({INS (NoEllipses, [t]), OUTS (NoEllipses, [NumT I32T])}, eps)
  -- if t = NumT $type_num<itestop,itestop,ftestop,ftestop>(top)

rule Instr_ok/binop:
  C_0 irt |- BINOP bop : ({INS (NoEllipses, [t, t]), OUTS (NoEllipses, [t])}, eps)
  -- if t = NumT $type_num<ibinop,ibinop,fbinop,fbinop>(bop)

rule Instr_ok/cvtop:
  C_0 irt |- CONVERT cop : ({INS (NoEllipses, [NumT nt_1]), OUTS (NoEllipses, [NumT nt_2])}, eps)
  -- if (nt_1, nt_2) = $type_cvtop(cop)

rule Instr_ok/relop:
  C_0 irt |- COMPARE rop : ({INS (NoEllipses, [t, t]), OUTS (NoEllipses, [NumT I32T])}, eps)
  -- if t = NumT $type_num<irelop,irelop,frelop,frelop>(rop)

rule Instr_ok/local.get:
  C_0 irt |- LOCAL.GET x : ({INS (NoEllipses, eps), OUTS (NoEllipses, [t])}, eps)
  -- if LocalT Set t = C_0.LOCALS[x]

rule Instr_ok/local.set:
  C_0 irt |- LOCAL.SET x : ({INS (NoEllipses, [t]), OUTS (NoEllipses, eps)}, eps)
  -- if LocalT init t = C_0.LOCALS[x]

rule Instr_ok/local.tee:
  C_0 irt |- LOCAL.TEE x : ({INS (NoEllipses, [t]), OUTS (NoEllipses, [t])}, eps)
  -- if LocalT init t = C_0.LOCALS[x]

rule Instr_ok/global.get:
  C_0 irt |- GLOBAL.GET x : ({INS (NoEllipses, eps), OUTS (NoEllipses, [t])}, eps)
  -- if GlobalT mut t = C_0.GLOBALS[x]

rule Instr_ok/global.set:
  C_0 irt |- GLOBAL.SET x : ({INS (NoEllipses, [t]), OUTS (NoEllipses, eps)}, eps)
  -- if GlobalT Var t = C_0.GLOBALS[x]

rule Instr_ok/table.get:
  C_0 irt |- TABLE.GET x : ({INS (NoEllipses, [t]), OUTS (NoEllipses, [RefT rt])}, eps)
  -- if TableT at lim rt = C_0.TABLES[x]
  -- if t = NumT $numtype_of_addrtype(at)

rule Instr_ok/table.set:
  C_0 irt |- TABLE.SET x : ({INS (NoEllipses, [t, RefT rt]), OUTS (NoEllipses, eps)}, eps)
  -- if TableT at lim rt = C_0.TABLES[x]
  -- if t = NumT $numtype_of_addrtype(at)

rule Instr_ok/table.size:
  C_0 irt |- TABLE.SIZE x : ({INS (NoEllipses, eps), OUTS (NoEllipses, [t])}, eps)
  -- if TableT at lim rt = C_0.TABLES[x]
  -- if t = NumT $numtype_of_addrtype(at)

rule Instr_ok/table.grow:
  C_0 irt |- TABLE.GROW x : ({INS (NoEllipses, [RefT rt, t]), OUTS (NoEllipses, [t])}, eps)
  -- if TableT at lim rt = C_0.TABLES[x]
  -- if t = NumT $numtype_of_addrtype(at)

rule Instr_ok/table.fill:
  C_0 irt |- TABLE.FILL x : ({INS (NoEllipses, [t, RefT rt, t]), OUTS (NoEllipses, eps)}, eps)
  -- if TableT at lim rt = C_0.TABLES[x]
  -- if t = NumT $numtype_of_addrtype(at)

rule Instr_ok/table.copy:
  C_0 irt |- TABLE.COPY x y : ({INS (NoEllipses, [t_1, t_2, t_min]), OUTS (NoEllipses, eps)}, eps)
  -- if TableT at_1 lim_1 rt_1 = C_0.TABLES[x]
  -- if TableT at_2 lim_2 rt_2 = C_0.TABLES[y]
  -- if $match_reftype(C_0.TYPES, rt_2, rt_1)
  -- if t_1 = NumT $numtype_of_addrtype(at_1)
  -- if t_2 = NumT $numtype_of_addrtype(at_2)
  -- if t_min = NumT $numtype_of_addrtype($min_addrtype(at_1, at_2))

rule Instr_ok/table.init:
  C_0 irt |- TABLE.INIT x y : ({INS (NoEllipses, [t, NumT I32T, NumT I32T]), OUTS (NoEllipses, eps)}, eps)
  -- if TableT at lim rt = C_0.TABLES[x]
  -- if rt' = C_0.ELEMS[y]
  -- if $match_reftype(C_0.TYPES, rt', rt)
  -- if t = NumT $numtype_of_addrtype(at)

rule Instr_ok/elem.drop:
  C_0 irt |- ELEM.DROP x : ({INS (NoEllipses, eps), OUTS (NoEllipses, eps)}, eps)
  -- if _ = C_0.ELEMS[x]

rule Instr_ok/vec.const:
  C_0 irt |- VEC.CONST vec : ({INS (NoEllipses, eps), OUTS (NoEllipses, [t])}, eps)
  -- if t = VecT $type_vecop<v128>(vec)

rule Instr_ok/vec.test:
  C_0 irt |- VEC.TEST vtop : ({INS (NoEllipses, [t]), OUTS (NoEllipses, [NumT I32T])}, eps)
  -- if t = VecT $type_vecop<vtestop>(vtop)

rule Instr_ok/vec.unary:
  C_0 irt |- VEC.UNARY vuop : ({INS (NoEllipses, [t]), OUTS (NoEllipses, [t])}, eps)
  -- if t = VecT $type_vecop<vunop>(vuop)

rule Instr_ok/vec.binary:
  C_0 irt |- VEC.BINARY vbop : ({INS (NoEllipses, [t, t]), OUTS (NoEllipses, [t])}, eps)
  -- Vecbinop_ok: |- vbop : OK
  -- if t = VecT $type_vecop<vbinop>(vbop)

rule Instr_ok/vec.ternary:
  C_0 irt |- VEC.TERNARY vterop : ({INS (NoEllipses, [t, t, t]), OUTS (NoEllipses, [t])}, eps)
  -- if t = VecT $type_vecop<vternop>(vterop)

rule Instr_ok/vec.compare:
  C_0 irt |- VEC.COMPARE vrop : ({INS (NoEllipses, [t, t]), OUTS (NoEllipses, [t])}, eps)
  -- if t = VecT $type_vecop<vrelop>(vrop)

rule Instr_ok/vec.convert:
  C_0 irt |- VEC.CONVERT vcvop : ({INS (NoEllipses, [t]), OUTS (NoEllipses, [t])}, eps)
  -- if t = VecT $type_vecop<vcvtop>(vcvop)

rule Instr_ok/vec.shift:
  C_0 irt |- VEC.SHIFT vshop : ({INS (NoEllipses, [t, NumT I32T]), OUTS (NoEllipses, [t])}, eps)
  -- if t = VecT $type_vecop<vshiftop>(vshop)

rule Instr_ok/vec.bitmask:
  C_0 irt |- VEC.BITMASK vbitop : ({INS (NoEllipses, [t]), OUTS (NoEllipses, [NumT I32T])}, eps)
  -- if t = VecT $type_vecop<vbitmaskop>(vbitop)

rule Instr_ok/vec.testbits:
  C_0 irt |- VEC.TESTBITS vvtop : ({INS (NoEllipses, [t]), OUTS (NoEllipses, [NumT I32T])}, eps)
  -- if t = VecT $type_vecop<vvtestop>(vvtop)

rule Instr_ok/vec.unarybits:
  C_0 irt |- VEC.UNARYBITS vvuop : ({INS (NoEllipses, [t]), OUTS (NoEllipses, [t])}, eps)
  -- if t = VecT $type_vecop<vvunop>(vvuop)

rule Instr_ok/vec.binarybits:
  C_0 irt |- VEC.BINARYBITS vvbop : ({INS (NoEllipses, [t, t]), OUTS (NoEllipses, [t])}, eps)
  -- if t = VecT $type_vecop<vvbinop>(vvbop)

rule Instr_ok/vec.ternarybits:
  C_0 irt |- VEC.TERNARYBITS vvterop : ({INS (NoEllipses, [t, t, t]), OUTS (NoEllipses, [t])}, eps)
  -- if t = VecT $type_vecop<vvternop>(vvterop)

rule Instr_ok/vec.splat:
  C_0 irt |- VEC.SPLAT vspop : ({INS (NoEllipses, [t_1]), OUTS (NoEllipses, [t_2])}, eps)
  -- if t_1 = NumT $type_vec_lane<vnsplatop,vnsplatop,vnsplatop,vnsplatop,vnsplatop,vnsplatop>(vspop)
  -- if t_2 = VecT $type_vecop<vsplatop>(vspop)

rule Instr_ok/vec.extract:
  C_0 irt |- VEC.EXTRACT vexop : ({INS (NoEllipses, [t_1]), OUTS (NoEllipses, [t_2])}, eps)
  -- if t_1 = VecT $type_vecop<vextractop>(vexop)
  -- if t_2 = NumT $type_vec_lane<vnextractop<extension>,vnextractop<extension>,vnextractop<void>,vnextractop<void>,vnextractop<void>,vnextractop<void>>(vexop)
  -- if $($lane_extractop(vexop) < $num_lanes<vnextractop<extension>,vnextractop<extension>,vnextractop<void>,vnextractop<void>,vnextractop<void>,vnextractop<void>>(vexop))

rule Instr_ok/vec.replace:
  C_0 irt |- VEC.REPLACE vrepop : ({INS (NoEllipses, [t_1, t_2]), OUTS (NoEllipses, [t_1])}, eps)
  -- if t_1 = VecT $type_vecop<vreplaceop>(vrepop)
  -- if t_2 = NumT $type_vec_lane<vnreplaceop,vnreplaceop,vnreplaceop,vnreplaceop,vnreplaceop,vnreplaceop>(vrepop)
  -- if $($lane_replaceop(vrepop) < $num_lanes<vnreplaceop,vnreplaceop,vnreplaceop,vnreplaceop,vnreplaceop,vnreplaceop>(vrepop))

rule Instr_ok/const:
  C_0 irt |- CONST num : ({INS (NoEllipses, eps), OUTS (NoEllipses, [t])}, eps)
  -- if t = NumT $type_num<i32,i64,f32,f64>(num)

rule Instrs_ok/empty:
  C_0 irt |- eps : (irt, eps)

rule Instrs_ok/cons:
  C_0 irt |- instr_1 :: instr* : (irt', idx'*)
  -- Instr_ok: C_0 irt |- instr_1 : ({INS irt_1, OUTS irt_2}, idx*)
  -- if C_1 = $init_locals(C_0, idx*)
  -- if (ellipses, valtype*) = $push(C_0, irt_2, $pop(C_0, irt_1, irt))
  -- Instrs_ok: C_1 (ellipses, valtype*) |-  instr* : (irt', idx'*)


relation Block_ok:
  context instrtype |- const : OK
  hint(input %0 %1 %2)

rule Block_ok:
  C_0 (InstrT t_1* t_2* x*) |- instr* : OK
  -- Instrs_ok: C_0 $stack(t_1*) |- instr* : (irt, x'*)
  -- if (ellipses, t'*) = $pop(C_0, $stack(t_2*), irt)
  -- if t'* = eps