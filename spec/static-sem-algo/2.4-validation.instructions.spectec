  -- if t = NumT $numtype_of_addrtype(at)

rule Instr_ok/table.copy:
  C_0 irt |- TABLE.COPY x y : ({INS (NoEllipses, [t_1, t_2, t_min]), OUTS (NoEllipses, eps)}, eps)
  -- if TableT at_1 lim_1 rt_1 = C_0.TABLES[x]
  -- if TableT at_2 lim_2 rt_2 = C_0.TABLES[y]
  -- if $match_reftype(C_0.TYPES, rt_2, rt_1)
  -- if t_1 = NumT $numtype_of_addrtype(at_1)
  -- if t_2 = NumT $numtype_of_addrtype(at_2)
  -- if t_min = NumT $numtype_of_addrtype($min_addrtype(at_1, at_2))

rule Instr_ok/table.init:
  C_0 irt |- TABLE.INIT x y : ({INS (NoEllipses, [t, NumT I32T, NumT I32T]), OUTS (NoEllipses, eps)}, eps)
  -- if TableT at lim rt = C_0.TABLES[x]
  -- if rt' = C_0.ELEMS[y]
  -- if $match_reftype(C_0.TYPES, rt', rt)
  -- if t = NumT $numtype_of_addrtype(at)

rule Instr_ok/elem.drop:
  C_0 irt |- ELEM.DROP x : ({INS (NoEllipses, eps), OUTS (NoEllipses, eps)}, eps)
  -- if _ = C_0.ELEMS[x]

rule Instr_ok/load:
  C_0 irt |- LOAD x loadop_ : ({INS (NoEllipses, [NumT $numtype_of_addrtype(at)]), OUTS (NoEllipses, [NumT nt])}, eps)
  -- if MemoryT at lim = C_0.MEMS[x]
  -- Loadop_ok: C_0 |- loadop_ : nt

rule Instr_ok/store:
  C_0 irt |- STORE x storeop_ : ({INS (NoEllipses, [NumT $numtype_of_addrtype(at), NumT nt]), OUTS (NoEllipses, eps)}, eps)
  -- if MemoryT at lim = C_0.MEMS[x]
  -- Storeop_ok: C_0 |- storeop_ : nt

rule Instr_ok/vec.load:
  C_0 irt |- VEC.LOAD x vloadop_ : ({INS (NoEllipses, [NumT $numtype_of_addrtype(at)]), OUTS (NoEllipses, [VecT vt])}, eps)
  -- if MemoryT at lim = C_0.MEMS[x]
  -- Vloadop_ok: C_0 |- vloadop_ : vt

rule Instr_ok/vec.store:
  C_0 irt |- VEC.STORE x vstoreop_ : ({INS (NoEllipses, [NumT $numtype_of_addrtype(at), VecT vt]), OUTS (NoEllipses, eps)}, eps)
  -- if MemoryT at lim = C_0.MEMS[x]
  -- Vstoreop_ok: C_0 |- vstoreop_ : vt

rule Instr_ok/vec.load_lane:
  C_0 irt |- VEC.LOAD_LANE x vlaneop_ int_1 : ({INS (NoEllipses, [NumT $numtype_of_addrtype(at), VecT vt]), OUTS (NoEllipses, [VecT vt])}, eps)
  -- if vlaneop_ = { TYPE _, ALIGN _, OFFSET _, PACK packtype }
  -- if MemoryT at lim = C_0.MEMS[x]
  -- Vlaneop_ok: C_0 |- vlaneop_ : vt
  -- if $(int_1 < ($vec_size(vt) / $pack_size(packtype)))

rule Instr_ok/vec.store_lane:
  C_0 irt |- VEC.STORE_LANE x vlaneop_ int_1 : ({INS (NoEllipses, [NumT $numtype_of_addrtype(at), VecT vt]), OUTS (NoEllipses, eps)}, eps)
  -- if vlaneop_ = { TYPE _, ALIGN _, OFFSET _, PACK packtype }
  -- if MemoryT at lim = C_0.MEMS[x]
  -- Vlaneop_ok: C_0 |- vlaneop_ : vt
  -- if $(int_1 < ($vec_size(vt) / $pack_size(packtype)))

rule Instr_ok/memory.size:
