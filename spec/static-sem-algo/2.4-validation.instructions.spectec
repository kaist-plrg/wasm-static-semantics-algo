relation Instrs_ok: context inferresulttype |- instr* : (inferresulttype, idx*)   hint(input %0 %1 %2)
relation Instr_ok: context inferresulttype |- instr : inferinstrtype              hint(input %0 %1 %2)
relation Block_ok: context instrtype |- const : OK                                hint(input %0 %1 %2)

relation Pack_ok: int |- packtype : OK   hint(input %0 %1)
rule Pack_ok:
  i |- packtype : OK
  -- if $($pack_size(packtype) < i)

relation Unop_ok: |- unop_ : OK          hint(input %0)
rule Unop_ok/i32:
  |- uop : OK
  -- if uop = I32 (ExtendS packtype)
  -- Pack_ok: $num_size($type_num<iunop, iunop, funop, funop>(uop)) |- packtype : OK

rule Unop_ok/i64:
  |- uop : OK
  -- if uop = I64 (ExtendS packtype)
  -- Pack_ok: $num_size($type_num<iunop, iunop, funop, funop>(uop)) |- packtype : OK

rule Unop_ok/else:
  |- uop : OK

dec $check_lane_index(int*) : bool
def $check_lane_index(i_1 :: i*) = false
  -- if $(i_1 >= 32)
def $check_lane_index(i_1 :: i*) = $check_lane_index(i*)
  -- if $(i_1 < 32)
def $check_lane_index(eps) = true

dec $check_vbop_shuffle(vbinop_) : bool
def $check_vbop_shuffle(V128 (I8x16 (Shuffle _))) = true
def $check_vbop_shuffle(vbop) = false
  -- otherwise

relation Vecbinop_ok: |- vbinop_ : OK    hint(input %0)
rule Vecbinop_ok/i816:
  |- vbop : OK
  -- if vbop = V128 (I8x16 (Shuffle i*))
  -- if $check_lane_index(i*)

rule Vecbinop_ok/else:
  |- vbop : OK
  -- if ~$check_vbop_shuffle(vbop)

relation Loadop_ok: context |- loadop_ : numtype  hint(input %0 %1)
rule Loadop_ok/some-i32at:
  C_0 |- { TYPE nt, ALIGN int_1, OFFSET int_2, PACK (packtype, extension) } : nt
  -- Pack_ok: $num_size(nt) |- packtype : OK
  -- if int_3 = $pack_size(packtype)
  -- if $($lsl_(1, int_1) >= 1) /\ $($lsl_(1, int_1) <= int_3)
  -- if MemoryT I32AT lim = C_0.MEMS[0]
  -- if $lt_u(int_2, 4294967296)

rule Loadop_ok/some-i64at:
  C_0 |- { TYPE nt, ALIGN int_1, OFFSET int_2, PACK (packtype, extension) } : nt
  -- Pack_ok: $num_size(nt) |- packtype : OK
  -- if int_3 = $pack_size(packtype)
  -- if $($lsl_(1, int_1) >= 1) /\ $($lsl_(1, int_1) <= int_3)
  -- if MemoryT I64AT lim = C_0.MEMS[0]

rule Loadop_ok/none-i32at:
  C_0 |- { TYPE nt, ALIGN int_1, OFFSET int_2, PACK eps } : nt
  -- if int_3 = $num_size(nt)
  -- if $($lsl_(1, int_1) >= 1) /\ $($lsl_(1, int_1) <= int_3)
  -- if MemoryT I32AT lim = C_0.MEMS[0]
  -- if $lt_u(int_2, 4294967296)

rule Loadop_ok/none-i64at:
  C_0 |- { TYPE nt, ALIGN int_1, OFFSET int_2, PACK eps } : nt
  -- if int_3 = $num_size(nt)
  -- if $($lsl_(1, int_1) >= 1) /\ $($lsl_(1, int_1) <= int_3)
  -- if MemoryT I64AT lim = C_0.MEMS[0]

