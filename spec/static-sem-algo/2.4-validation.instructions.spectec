rule Instr_ok/unreachable:
  C_0 irt |- UNREACHABLE : ({INS (Ellipses, eps), OUTS (Ellipses, eps)}, eps)

rule Instr_ok/nop:
  C_0 irt |- NOP : ({INS (NoEllipses, eps), OUTS (NoEllipses, eps)}, eps)

rule Instr_ok/drop:
  C_0 irt |- DROP : ({INS (NoEllipses, [$peek(0, irt)]), OUTS (NoEllipses, eps)}, eps)

rule Instr_ok/select-none:
  C_0 irt |- SELECT eps : ({INS (NoEllipses, [t, t, NumT I32T]), OUTS (NoEllipses, [t])}, eps)
  -- if t = $peek(1, irt)
  -- if $is_num_type(t) \/ $is_vec_type(t)

rule Instr_ok/select-some:
  C_0 irt |- SELECT t* : ({INS (NoEllipses, t* ++ t* ++ [NumT I32T]), OUTS (NoEllipses, t*)}, eps)
  -- if |t*| = 1
  -- Resulttype_ok: C_0 |- t* : OK

rule Instr_ok/block:
  C_0 irt |- BLOCK blocktype instr* : ({INS (NoEllipses, t_1*), OUTS (NoEllipses, t_2*)}, x*)
  -- Blocktype_ok: C_0 |- blocktype : (InstrT t_1* t_2* x*)
  -- Block_ok: C_0[ .LABELS = t_2* ++ C_0.LABELS ] (InstrT t_1* t_2* x*) |- instr* : OK

rule Instr_ok/loop:
  C_0 irt |- LOOP blocktype instr* : ({INS (NoEllipses, t_1*), OUTS (NoEllipses, t_2*)}, x*)
  -- Blocktype_ok: C_0 |- blocktype : (InstrT t_1* t_2* x*)
  -- Block_ok: C_0[ .LABELS = t_1* ++ C_0.LABELS ] (InstrT t_1* t_2* x*) |- instr* : OK

rule Instr_ok/if':
  C_0 irt |- IF blocktype instr_t* ELSE instr_f* : ({INS (NoEllipses, t_1* ++ [NumT I32T]), OUTS (NoEllipses, t_2*)}, x*)
  -- Blocktype_ok: C_0 |- blocktype : (InstrT t_1* t_2* x*)
  -- Block_ok: C_0[ .LABELS = t_2* ++ C_0.LABELS ] (InstrT t_1* t_2* x*) |- instr_t* : OK
  -- Block_ok: C_0[ .LABELS = t_2* ++ C_0.LABELS ] (InstrT t_1* t_2* x*) |- instr_f* : OK

rule Instr_ok/br:
  C_0 irt |- BR x : ({INS (Ellipses, C_0.LABELS[x]), OUTS (Ellipses, eps)}, eps)

rule Instr_ok/br_if:
  C_0 irt |- BR_IF x : ({INS (NoEllipses, t* ++ [NumT I32T]), OUTS (NoEllipses, t*)}, eps)
  -- if t* = C_0.LABELS[x]

rule Instr_ok/br_table:
  C_0 irt |- BR_TABLE x* y : ({INS (Ellipses, t* ++ [NumT I32T]), OUTS (Ellipses, eps)}, eps)
  -- if n = |C_0.LABELS[y]|
  -- if t* = $init_valtypes(irt, 0, n)
  -- Match_resulttype: C_0 |- t* C_0.LABELS[y] : OK
  -- (Match_resulttype: C_0 |- t* C_0.LABELS[x] : OK)*

rule Instr_ok/br_on_null:
  C_0 irt |- BR_ON_NULL x : ({INS (NoEllipses, t* ++ [RefT (Null ht)]), OUTS (NoEllipses, t* ++ [RefT (NoNull ht)])}, eps)
  -- if null ht = $peek_ref(0, irt)
  -- if t* = C_0.LABELS[x]

rule Instr_ok/br_on_non_null:
  C_0 irt |- BR_ON_NON_NULL x : ({INS (NoEllipses, t_h* ++ [RefT (Null ht)]), OUTS (NoEllipses, t_h*)}, eps)
  -- if null ht = $peek_ref(0, irt)
  -- if t' = RefT (NoNull ht)
  -- if i = |C_0.LABELS[x]|
  -- if $(i > 0)
  -- if t_h* = C_0.LABELS[x][0:i-1]
  -- if t_l = C_0.LABELS[x][i-1]
  -- if $match_valtype(C_0.TYPES, t', t_l)

rule Instr_ok/br_on_cast:
  C_0 irt |- BR_ON_CAST x rt_1 rt_2 : ({INS (NoEllipses, t_h* ++ [RefT rt_1]), OUTS (NoEllipses, t_h* ++ [RefT $diff_reftype(rt_1, rt_2)])}, eps)
  -- Reftype_ok: C_0 |- rt_1 : OK
  -- Reftype_ok: C_0 |- rt_2 : OK
  -- if $match_reftype(C_0.TYPES, rt_2, rt_1)
  -- if i = |C_0.LABELS[x]|
  -- if $(i > 0)
  -- if t_h* = C_0.LABELS[x][0:i-1]
  -- if t_l = C_0.LABELS[x][i-1]
  -- if $match_valtype(C_0.TYPES, RefT rt_2, t_l)

rule Instr_ok/br_on_cast_fail:
  C_0 irt |- BR_ON_CAST_FAIL x rt_1 rt_2 : ({INS (NoEllipses, t_h* ++ [RefT rt_1]), OUTS (NoEllipses, t_h* ++ [RefT rt_2])}, eps)
  -- Reftype_ok: C_0 |- rt_1 : OK
  -- Reftype_ok: C_0 |- rt_2 : OK
  -- if rt_1' = $diff_reftype(rt_1, rt_2)
  -- if $match_reftype(C_0.TYPES, rt_2, rt_1)
  -- if i = |C_0.LABELS[x]|
  -- if $(i > 0)
  -- if t_h* = C_0.LABELS[x][0:i-1]
  -- if t_l = C_0.LABELS[x][i-1]
  -- if $match_valtype(C_0.TYPES, RefT rt_1', t_l)

rule Instr_ok/call:
  C_0 irt |- CALL x : ({INS (NoEllipses, t_1*), OUTS (NoEllipses, t_2*)}, eps)
  -- if FuncT t_1* t_2* = $functype_of_strtype($expanddt(C_0.FUNCS[x]))

rule Instr_ok/call_ref:
  C_0 irt |- CALL_REF x : ({INS (NoEllipses, t_1* ++ [RefT (Null (DefHT C_0.TYPES[x]))]), OUTS (NoEllipses, t_2*)}, eps)
  -- if FuncT t_1* t_2* = $func_type(C_0, x)

rule Instr_ok/call_indirect:
  C_0 irt |- CALL_INDIRECT x y : ({INS (NoEllipses, t_1* ++ [NumT $numtype_of_addrtype(at)]), OUTS (NoEllipses, t_2*)}, eps)
  -- if TableT at lim rt = C_0.TABLES[x]
  -- if FuncT t_1* t_2* = $func_type(C_0, y)
  -- if $match_reftype(C_0.TYPES, rt, (Null FuncHT))

rule Instr_ok/return:
  C_0 irt |- RETURN : ({INS (Ellipses, C_0.RESULTS), OUTS (Ellipses, eps)}, eps)

rule Instr_ok/return_call:
  C_0 irt |- RETURN_CALL x : ({INS (Ellipses, t_1*), OUTS (Ellipses, eps)}, eps)
  -- if FuncT t_1* t_2* = $functype_of_strtype($expanddt(C_0.FUNCS[x]))
  -- if $match_resulttype(C_0.TYPES, t_2*, C_0.RESULTS)

rule Instr_ok/return_call_ref:
  C_0 irt |- RETURN_CALL_REF x : ({INS (Ellipses, t_1* ++ [RefT (Null (DefHT C_0.TYPES[x]))]), OUTS (Ellipses, eps)}, eps)
  -- if FuncT t_1* t_2* = $func_type(C_0, x)
  -- if $match_resulttype(C_0.TYPES, t_2*, C_0.RESULTS)

rule Instr_ok/return_call_indirect:
  C_0 irt |- RETURN_CALL_INDIRECT x y : ({INS (Ellipses, t_1* ++ [NumT $numtype_of_addrtype(at)]), OUTS (Ellipses, eps)}, eps)
  -- if TableT at lim rt = C_0.TABLES[x]
  -- if FuncT t_1* t_2* = $func_type(C_0, y)
  -- if $match_reftype(C_0.TYPES, rt, (Null FuncHT))
  -- if $match_resulttype(C_0.TYPES, t_2*, C_0.RESULTS)

rule Instr_ok/throw:
  C_0 irt |- THROW x : ({INS (Ellipses, t_1*), OUTS (Ellipses, eps)}, eps)
  -- if TagT dt = C_0.TAGS[x]
  -- if FuncT t_1* t_2* = $functype_of_strtype($expanddt(dt))

rule Instr_ok/throw_ref:
  C_0 irt |- THROW_REF : ({INS (Ellipses, [RefT (Null ExnHT)]), OUTS (Ellipses, eps)}, eps)

rule Instr_ok/try_table:
  C_0 irt |- TRY_TABLE blocktype catch* instr* : ({INS (NoEllipses, t_1*), OUTS (NoEllipses, t_2*)}, x*)
  -- Blocktype_ok: C_0 |- blocktype : (InstrT t_1* t_2* x*)
  -- if C_1 = C_0[ .LABELS = t_2* ++ C_0.LABELS ]
  -- (Catch_ok: C_0 t_2* |- catch : OK)*
  -- Block_ok: C_1 (InstrT t_1* t_2* x*) |- instr* : OK

rule Instr_ok/local.get:
  C_0 irt |- LOCAL.GET x : ({INS (NoEllipses, eps), OUTS (NoEllipses, [t])}, eps)
  -- if LocalT Set t = C_0.LOCALS[x]

rule Instr_ok/local.set:
  C_0 irt |- LOCAL.SET x : ({INS (NoEllipses, [t]), OUTS (NoEllipses, eps)}, [x])
  -- if LocalT init t = C_0.LOCALS[x]

rule Instr_ok/local.tee:
