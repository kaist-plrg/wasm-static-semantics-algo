;; Instructions

;; Operators
syntax op<A, B, C, D> =
  | I32 A | I64 B | F32 C | F64 D

syntax iunop =
  | Clz | Ctz | Popcnt | ExtendS packtype
syntax funop =
  | Neg | Abs | Ceil | Floor | Trunc | Nearest | Sqrt
syntax unop_ = op<iunop, iunop, funop, funop>
var uop : unop_

syntax ibinop =
  | IAdd | ISub | IMul | IDivS | IDivU | IRemS | IRemU
  | IAnd | IOr | IXor | IShl | IShrS | IShrU | IRotl | IRotr
syntax fbinop =
  | FAdd | FSub | FMul | FDiv | FMin | FMax | FCopysign
syntax binop_ = op<ibinop, ibinop, fbinop, fbinop>
var bop : binop_

syntax irelop =
  | Eq | Ne | LtS | LtU | GtS | GtU | LeS | LeU | GeS | GeU
syntax frelop =
  | Eq | Ne | Lt | Gt | Le | Ge
syntax relop_ = op<irelop, irelop, frelop, frelop>
var rop : relop_

syntax num_ = op<i32, i64, f32, f64>
var num : num_

syntax itestop = | Eqz
syntax ftestop
syntax testop_ = op<itestop, itestop, ftestop, ftestop>
var top : testop_

syntax icvtop =
  | ExtendSI32 | ExtendUI32 | WrapI64
  | TruncSF32 | TruncUF32 | TruncSF64 | TruncUF64
  | TruncSatSF32 | TruncSatUF32 | TruncSatSF64 | TruncSatUF64
  | ReinterpretFloat
syntax fcvtop =
  | ConvertSI32 | ConvertUI32 | ConvertSI64 | ConvertUI64
  | PromoteF32 | DemoteF64
  | ReinterpretInt
syntax cvtop_ = op<icvtop, icvtop, fcvtop, fcvtop>
var cop : cvtop_

syntax vitestop = AllTrue
syntax vtestop = laneop<vitestop, vitestop, vitestop, vitestop, void, void>
syntax vtestop_ = vecop<vtestop>
var vtop : vtestop_

syntax viunop =
  | Abs | Neg | Popcnt
syntax vfunop =
  | Abs | Neg | Sqrt | Ceil | Floor | Trunc | Nearest
syntax vunop = laneop<viunop, viunop, viunop, viunop, vfunop, vfunop>
syntax vunop_ = vecop<vunop>
var vuop : vunop_

syntax vibinop =
  | Add | Sub | Mul | MinS | MinU | MaxS | MaxU | AvgrU
  | AddSatS | AddSatU | SubSatS | SubSatU | DotS | Q15MulRSatS
  | ExtMulLowS | ExtMulHighS | ExtMulLowU | ExtMulHighU
  | Swizzle | Shuffle int* | NarrowS | NarrowU
  | RelaxedSwizzle | RelaxedQ15MulRS | RelaxedDot
syntax vfbinop =
  | Add | Sub | Mul | Div | Min | Max | Pmin | Pmax
  | RelaxedMin | RelaxedMax
syntax vbinop = laneop<vibinop, vibinop, vibinop, vibinop, vfbinop, vfbinop>
syntax vbinop_ = vecop<vbinop>
var vbop : vbinop_

syntax viternop =
  | RelaxedLaneselect | RelaxedDotAdd
syntax vfternop =
  | RelaxedMadd | RelaxedNmadd
syntax vternop = laneop<viternop, viternop, viternop, viternop, vfternop, vfternop>
syntax vternop_ = vecop<vternop>
var vterop : vternop_

syntax virelop =
  | Eq | Ne | LtS | LtU | LeS | LeU | GtS | GtU | GeS | GeU
syntax vfrelop =
  | Eq | Ne | Lt | Le | Gt | Ge
syntax vrelop = laneop<virelop, virelop, virelop, virelop, vfrelop, vfrelop>
syntax vrelop_ = vecop<vrelop>
var vrop : vrelop_

syntax vicvtop =
  | ExtendLowS | ExtendLowU | ExtendHighS | ExtendHighU
  | ExtAddPairwiseS | ExtAddPairwiseU
  | TruncSatSF32x4 | TruncSatUF32x4
  | TruncSatSZeroF64x2 | TruncSatUZeroF64x2
  | RelaxedTruncSF32x4 | RelaxedTruncUF32x4
  | RelaxedTruncSZeroF64x2 | RelaxedTruncUZeroF64x2
syntax vfcvtop =
  | DemoteZeroF64x2 | PromoteLowF32x4
  | ConvertSI32x4 | ConvertUI32x4
syntax vcvtop = laneop<vicvtop, vicvtop, vicvtop, vicvtop, vfcvtop, vfcvtop>
syntax vcvtop_ = vecop<vcvtop>
var vcvop : vcvtop_

syntax vishiftop =
  | Shl | ShrS | ShrU
syntax vshiftop = laneop<vishiftop, vishiftop, vishiftop, vishiftop, void, void>
syntax vshiftop_ = vecop<vshiftop>
var vshop : vshiftop_

syntax vibitmaskop = | Bitmask
syntax vbitmaskop = laneop<vibitmaskop, vibitmaskop, vibitmaskop, vibitmaskop, void, void>
syntax vbitmaskop_ = vecop<vbitmaskop>
var vbitop : vbitmaskop_

syntax vvtestop = AnyTrue
syntax vvtestop_ = vecop<vvtestop>
var vvtop : vvtestop_

syntax vvunop = Not
syntax vvunop_ = vecop<vvunop>
var vvuop : vvunop_

syntax vvbinop = | And | Or | Xor | AndNot
syntax vvbinop_ = vecop<vvbinop>
var vvbop : vvbinop_

syntax vvternop = | Bitselect
syntax vvternop_ = vecop<vvternop>
var vvterop : vvternop_

syntax vnsplatop = Splat
syntax vsplatop = laneop<vnsplatop, vnsplatop, vnsplatop, vnsplatop, vnsplatop, vnsplatop>
syntax vsplatop_ = vecop<vsplatop>
var vspop : vsplatop_

syntax vnextractop<X> = Extract (int, X)
syntax vextractop = laneop<vnextractop<extension>, vnextractop<extension>, vnextractop<void>, vnextractop<void>, vnextractop<void>, vnextractop<void>>
syntax vextractop_ = vecop<vextractop>
var vexop : vextractop_

syntax vnreplaceop = Replace int
syntax vreplaceop = laneop<vnreplaceop, vnreplaceop, vnreplaceop, vnreplaceop, vnreplaceop, vnreplaceop>
syntax vreplaceop_ = vecop<vreplaceop>
var vrepop : vreplaceop_

syntax instr =
  | UNARY unop_
  | TEST testop_
  | BINOP binop_
  | CONVERT cvtop_
  | COMPARE relop_
  | CONST num_
  | LOCAL.GET localidx
  | LOCAL.SET localidx
  | LOCAL.TEE localidx
  | GLOBAL.GET globalidx
  | GLOBAL.SET globalidx
  | TABLE.GET tableidx
  | TABLE.SET tableidx
  | TABLE.SIZE tableidx
  | TABLE.GROW tableidx
  | TABLE.FILL tableidx
  | TABLE.COPY tableidx tableidx
  | TABLE.INIT tableidx elemidx
  | ELEM.DROP elemidx
  | VEC.CONST vec_
  | VEC.TEST vtestop_
  | VEC.UNARY vunop_
  | VEC.BINARY vbinop_
  | VEC.TERNARY vternop_
  | VEC.COMPARE vrelop_
  | VEC.CONVERT vcvtop_
  | VEC.SHIFT vshiftop_
  | VEC.BITMASK vbitmaskop_
  | VEC.TESTBITS vvtestop_
  | VEC.UNARYBITS vvunop_
  | VEC.BINARYBITS vvbinop_
  | VEC.TERNARYBITS vvternop_
  | VEC.SPLAT vsplatop_
  | VEC.EXTRACT vextractop_
  | VEC.REPLACE vreplaceop_


syntax const = instr*

;; helper functions

dec $type_num<A,B,C,D>(op<A,B,C,D>) : numtype
def $type_num<A,B,C,D>(I32 A) = I32T
def $type_num<A,B,C,D>(I64 B) = I64T
def $type_num<A,B,C,D>(F32 C) = F32T
def $type_num<A,B,C,D>(F64 D) = F64T

dec $type_vecop<A>(vecop<A>) : vectype
def $type_vecop<A>(V128 _) = V128T

dec $type_cvtop(cvtop_) : (numtype, numtype)
def $type_cvtop(I32 icvtop) = (I64T, I32T)
  -- if icvtop <- [ WrapI64 ]
def $type_cvtop(I32 icvtop) = (F32T, I32T)
  -- if icvtop <- [ TruncSF32, TruncUF32, TruncSatSF32, TruncSatUF32,
                    ReinterpretFloat ]
def $type_cvtop(I32 icvtop) = (F64T, I32T)
  -- if icvtop <- [ TruncSF64, TruncUF64, TruncSatSF64, TruncSatUF64 ]
def $type_cvtop(I64 icvtop) = (I32T, I64T)
  -- if icvtop <- [ ExtendSI32, ExtendUI32 ]
def $type_cvtop(I64 icvtop) = (F32T, I64T)
  -- if icvtop <- [ TruncSF32, TruncUF32, TruncSatSF32, TruncSatUF32 ]
def $type_cvtop(I64 icvtop) = (F64T, I64T)
  -- if icvtop <- [ TruncSF64, TruncUF64, TruncSatSF64, TruncSatUF64, ReinterpretFloat ]
def $type_cvtop(F32 fcvtop) = (I32T, F32T)
  -- if fcvtop <- [ ConvertSI32, ConvertUI32, ReinterpretInt ]
def $type_cvtop(F32 fcvtop) = (I64T, F32T)
  -- if fcvtop <- [ ConvertSI64, ConvertUI64 ]
def $type_cvtop(F32 fcvtop) = (F64T, F32T)
  -- if fcvtop <- [ DemoteF64 ]
def $type_cvtop(F64 fcvtop) = (I32T, F64T)
  -- if fcvtop <- [ ConvertSI32, ConvertUI32 ]
def $type_cvtop(F64 fcvtop) = (I64T, F64T)
  -- if fcvtop <- [ ConvertSI64, ConvertUI64, ReinterpretInt ]
def $type_cvtop(F64 fcvtop) = (F32T, F64T)
  -- if fcvtop <- [ PromoteF32 ]

dec $type_lane<A,B,C,D,E,F>(laneop<A,B,C,D,E,F>) : numtype
def $type_lane<A,B,C,D,E,F>(I8x16 _) = I32T
def $type_lane<A,B,C,D,E,F>(I16x8 _) = I32T
def $type_lane<A,B,C,D,E,F>(I32x4 _) = I32T
def $type_lane<A,B,C,D,E,F>(I64x2 _) = I64T
def $type_lane<A,B,C,D,E,F>(F32x4 _) = F32T
def $type_lane<A,B,C,D,E,F>(F64x2 _) = F64T

dec $type_vec_lane<A,B,C,D,E,F>(vecop<laneop<A,B,C,D,E,F>>) : numtype
def $type_vec_lane<A,B,C,D,E,F>(V128 (I8x16 A)) = $type_lane<A,B,C,D,E,F>(I8x16 A)
def $type_vec_lane<A,B,C,D,E,F>(V128 (I16x8 B)) = $type_lane<A,B,C,D,E,F>(I16x8 B)
def $type_vec_lane<A,B,C,D,E,F>(V128 (I32x4 C)) = $type_lane<A,B,C,D,E,F>(I32x4 C)
def $type_vec_lane<A,B,C,D,E,F>(V128 (I64x2 D)) = $type_lane<A,B,C,D,E,F>(I64x2 D)
def $type_vec_lane<A,B,C,D,E,F>(V128 (F32x4 E)) = $type_lane<A,B,C,D,E,F>(F32x4 E)
def $type_vec_lane<A,B,C,D,E,F>(V128 (F64x2 F)) = $type_lane<A,B,C,D,E,F>(F64x2 F)

dec $lane_extractop(vecop<laneop<vnextractop<extension>,vnextractop<extension>,vnextractop<void>,vnextractop<void>,vnextractop<void>,vnextractop<void>>>) : int
def $lane_extractop(V128 (I8x16 (Extract (i, _)))) = i
def $lane_extractop(V128 (I16x8 (Extract (i, _)))) = i
def $lane_extractop(V128 (I32x4 (Extract (i, _)))) = i
def $lane_extractop(V128 (I64x2 (Extract (i, _)))) = i
def $lane_extractop(V128 (F32x4 (Extract (i, _)))) = i
def $lane_extractop(V128 (F64x2 (Extract (i, _)))) = i

dec $lane_replaceop(vecop<laneop<vnreplaceop, vnreplaceop, vnreplaceop, vnreplaceop, vnreplaceop, vnreplaceop>>) : int
def $lane_replaceop(V128 (I8x16 (Replace i))) = i
def $lane_replaceop(V128 (I16x8 (Replace i))) = i
def $lane_replaceop(V128 (I32x4 (Replace i))) = i
def $lane_replaceop(V128 (I64x2 (Replace i))) = i
def $lane_replaceop(V128 (F32x4 (Replace i))) = i
def $lane_replaceop(V128 (F64x2 (Replace i))) = i

dec $num_lanes<A,B,C,D,E,F>(vecop<laneop<A,B,C,D,E,F>>) : int
def $num_lanes<A,B,C,D,E,F>(V128 (I8x16 _)) = 16
def $num_lanes<A,B,C,D,E,F>(V128 (I16x8 _)) = 8
def $num_lanes<A,B,C,D,E,F>(V128 (I32x4 _)) = 4
def $num_lanes<A,B,C,D,E,F>(V128 (I64x2 _)) = 2
def $num_lanes<A,B,C,D,E,F>(V128 (F32x4 _)) = 4
def $num_lanes<A,B,C,D,E,F>(V128 (F64x2 _)) = 2