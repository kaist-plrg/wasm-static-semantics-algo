(include_subdirs unqualified)

(library
  (name wasm_interpreter)
  (public_name wasm_interpreter)
  (modules :standard \ main wasm wast smallint)
)

(executable
  (public_name wasm)
  (modules wasm)
  (libraries wasm_interpreter)
  (flags (-open Wasm_interpreter))
)

(executable
  (name smallint)
  (modules smallint)
  (libraries wasm_interpreter)
  (flags (-open Wasm_interpreter))
)

(executable
  (name wast)
  (modules wast)
  (modes js)
  (libraries js_of_ocaml wasm_interpreter)
  (preprocess (pps js_of_ocaml-ppx))
)

(env (_ (flags (-w +a-4-27-42-44-45-70 -warn-error +a-3))))

(subdir text
  (ocamllex (modules lexer))
  (menhir (modules parser))
)

(rule
  (targets wasm.ml)
  (deps main/main.ml)
  (action (copy main/main.ml wasm.ml))
)

(rule
  (alias runtest)
  (deps
    ./wasm.exe
    ./smallint.exe
    (source_tree ../test)
  )
  (action
    (progn
      (run ../test/core/run.py --wasm ./wasm.exe)
      (run ./smallint.exe)
    )
  )
)
